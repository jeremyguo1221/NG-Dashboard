# ── EIA API (free, required for storage/fundamentals) ────────────────────────
# Register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── Reddit API (free, optional) ───────────────────────────────────────────────
# Register at https://www.reddit.com/prefs/apps as a "script" application.
# If unset, the Reddit scraper falls back to the public /r/<sub>/new/.rss
# feeds (no auth, but rate-limited — some subs may be skipped per run).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NGSentimentBot/1.0 (by /u/your_reddit_handle)

# ── Discord webhook (optional) ────────────────────────────────────────────────
# Threshold alerts are posted here when set. Leave blank to log-only.
DISCORD_WEBHOOK_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite default. For Postgres: postgresql+psycopg2://user:pass@host:5432/db
DB_URL=sqlite:///data/sentiment.db

# ── Compute ──────────────────────────────────────────────────────────────────
# Set true to put FinBERT on CUDA (requires a torch build with CUDA support).
USE_GPU=false
